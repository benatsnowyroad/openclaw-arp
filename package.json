{
  "name": "@openclaw/arp",
  "version": "0.1.0",
  "description": "Agent Relay Protocol channel plugin for OpenClaw",
  "main": "src/index.ts",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "channel": {
      "id": "arp",
      "label": "Agent Relay Protocol",
      "selectionLabel": "ARP (Multi-agent coordination)",
      "docsPath": "/channels/arp",
      "blurb": "Multi-agent coordination and structured conversations via ARP"
    }
  },
  "keywords": [
    "openclaw",
    "arp",
    "multi-agent",
    "channel"
  ],
  "author": "Snowy Road",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
